#!/usr/bin/env python3
"""Run Gecko straight from a source checkout (``./gecko`` or a symlink to it).

Installing with ``pip install .`` provides the same ``gecko`` command.
"""
import sys
from pathlib import Path

# resolve() follows symlinks such as /usr/local/bin/gecko -> <repo>/gecko
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from gecko.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
